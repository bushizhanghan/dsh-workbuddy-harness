{
  "name": "@bushizhanghan/dsh-workmate",
  "displayName": "DSH Workmate",
  "description": "把 WorkBuddy 国内版与国际版的免费/付费模型接进 DeepSeek Harness，无需桌面端。WorkBuddy's free and paid models for DeepSeek Harness, international and domestic, no desktop app required.",
  "version": "1.2.7",
  "author": "bushizhanghan",
  "contributors": [
    {
      "name": "Faide-cyber",
      "url": "https://github.com/Faide-cyber/dsh-workbuddy"
    }
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "workbuddy-ai",
    "model-provider",
    "compat",
    "dsh-0.2.1",
    "fork"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-workmate": "lib/bin.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CHANGELOG.en.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-THIRD-PARTY"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bushizhanghan/dsh-workbuddy-harness.git"
  },
  "homepage": "https://github.com/bushizhanghan/dsh-workbuddy-harness#readme",
  "bugs": "https://github.com/bushizhanghan/dsh-workbuddy-harness/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-attachment": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2 <0.2.1 || >=0.2.1-0 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.87.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
